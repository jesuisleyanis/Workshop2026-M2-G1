# Proxy NATIF Windows devant la stack (mode « IP réelle », REAL_IP=1) — voir README.md.
#
# Lancé sur le PC hôte (pas dans Docker) : il voit la VRAIE IP du PC attaquant, que Docker Desktop masque.
# Il la transmet au WAF dans X-Forwarded-For (en ÉCRASANT toute valeur envoyée par le client : un client
# ne peut pas choisir son IP). Le WAF n'est joignable qu'en 127.0.0.1:8443 dans ce mode.
#   caddy run --config infra/caddy/Caddyfile        (ou : make caddy)
#
# Écoute UNIQUEMENT sur l'interface du hotspot et la boucle locale (CADDY_BIND, défaut ci-dessous) : sans
# `default_bind`, Caddy écoute sur TOUTES les interfaces (Wi-Fi/Ethernet du PC hôte compris), le filtrage par
# nom d'hôte ne restreignant pas l'écoute. Hotspot inactif (192.168.137.1 absente) : CADDY_BIND=127.0.0.1.
# Caddy >= 2.7 (default_bind ; {$VAR:défaut} peut s'étendre en plusieurs adresses séparées par des espaces).
{
	# Pas d'API d'administration : rien à exposer, la conf est relue au démarrage.
	admin off
	default_bind {$CADDY_BIND:192.168.137.1 127.0.0.1}
	# CA interne de labo : ne pas l'installer dans le magasin de certificats Windows (droits admin).
	skip_install_trust
	auto_https disable_redirects
}

# Points d'entrée : IP du hotspot (PC attaquant, jury) et poste local (scripts make verify, bench...).
https://192.168.137.1, https://localhost, https://127.0.0.1 {
	tls internal

	reverse_proxy https://127.0.0.1:8443 {
		# IP vue par Caddy = vraie IP du client ; jamais celle annoncée par le client.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		transport http {
			# Certificat auto-signé du WAF (lab fermé, sur la boucle locale).
			tls_insecure_skip_verify
		}
	}
}

http://192.168.137.1, http://localhost {
	redir https://{host}{uri} permanent
}
