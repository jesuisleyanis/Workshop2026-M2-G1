# EXEMPLE de secrets — valeurs FACTICES uniquement.
# Procédure :
#   1. Copier ce fichier en secrets.enc.env et y mettre de vraies valeurs générées.
#   2. Chiffrer :  sops --encrypt --in-place secrets.enc.env
#   3. Commiter UNIQUEMENT la version chiffrée. Ne jamais commiter de version en clair.
# Au déploiement, scripts/decrypt-secrets.sh produit un .env déchiffré, non commité.

# Secret de signature JWT (auth) — générer : openssl rand -hex 32
JWT_SECRET=change-me-fake-jwt-secret-0000000000000000

# Mot de passe Postgres (réseau data interne uniquement)
POSTGRES_PASSWORD=change-me-fake-db-password

# Token partagé detector -> remediation (auth de POST /events)
REMEDIATION_TOKEN=change-me-fake-remediation-token

# Token d'appel interne remediation -> auth (/internal/tighten-rate-limit)
INTERNAL_TOKEN=change-me-fake-internal-token

# Mot de passe commun des comptes FICTIFS du seed (demo01..demo05) — utilisé par `make seed`
# et par scripts/verify_tx (VERIFY_PASSWORD prime s'il est défini)
SEED_PASSWORD=change-me-fake-seed-password

# Mot de passe admin Grafana (réseau obs interne, aucun port publié) — le compose exige
# cette variable (plus de repli silencieux sur "admin")
GRAFANA_PASSWORD=change-me-fake-grafana-password
