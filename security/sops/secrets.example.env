# EXEMPLE de secrets — valeurs FACTICES uniquement.
# Procédure :
#   1. Copier ce fichier en secrets.enc.env et y mettre de vraies valeurs générées.
#   2. Chiffrer :  sops --encrypt --in-place secrets.enc.env
#   3. Commiter UNIQUEMENT la version chiffrée. Ne jamais commiter de version en clair.
# Au déploiement, scripts/decrypt-secrets.sh produit un .env déchiffré, non commité.

# Secret de signature JWT (auth) — générer : openssl rand -hex 32
JWT_SECRET=change-me-fake-jwt-secret-0000000000000000

# Mot de passe Postgres (réseau data interne uniquement) — générer : openssl rand -hex 32
# (hex volontaire : pas de / + = qui casseraient l'URL DATA_SOURCE_NAME du pg-exporter)
POSTGRES_PASSWORD=change-me-fake-db-password

# Token partagé detector -> remediation (auth de POST /events) — générer : openssl rand -hex 32
REMEDIATION_TOKEN=change-me-fake-remediation-token

# Token d'appel interne remediation -> auth (/internal/tighten-rate-limit) — générer : openssl rand -hex 32
INTERNAL_TOKEN=change-me-fake-internal-token

# Mot de passe commun des comptes FICTIFS du seed (demo01..demo05) — utilisé par `make seed`
# et par scripts/verify_tx (VERIFY_PASSWORD prime s'il est défini)
SEED_PASSWORD=change-me-fake-seed-password

# --- Authentification v2 : visage + back-office + LED (valeurs FACTICES) ---

# Token d'appel interne auth -> face-id (en-tête interne) — générer : openssl rand -hex 32
FACE_INTERNAL_TOKEN=change-me-face-internal-token-32c

# Clé AES-256 de chiffrement des gabarits et photos faciales : base64 de 32 octets aléatoires.
# VALEUR FACTICE ci-dessous (invalide volontairement) — générer :
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FACE_DATA_KEY=change-me-fake-base64-of-32-random-bytes

# Mots de passe MQTT (broker mosquitto) : `auth` publie les commandes LED, `led` = objet ESP8266.
# Générer : openssl rand -hex 24  (le fichier passwd du broker est produit au démarrage dans un tmpfs)
MQTT_AUTH_PASSWORD=change-me-mqtt-auth
MQTT_LED_PASSWORD=change-me-mqtt-led

# Jeton d'initialisation du premier compte admin du back-office (à usage unique) — générer : openssl rand -hex 32
BACKOFFICE_BOOTSTRAP_TOKEN=change-me-bootstrap-token

# IP du hotspot sur laquelle le port MQTT 1883 est publié (jamais 0.0.0.0)
MQTT_BIND=192.168.137.1

# Mot de passe admin Grafana (réseau obs interne, aucun port publié) — le compose exige
# cette variable (plus de repli silencieux sur "admin")
GRAFANA_PASSWORD=change-me-fake-grafana-password
