# WAF RESILIENCE-ALPHA — serveur reverse-proxy (remplace le default.conf de l'image CRS).
#
# Modèle rendu au DÉMARRAGE par l'entrypoint de l'image owasp/modsecurity-crs (envsubst) :
# seules les variables d'environnement définies (${PORT}, ${SSL_PORT}, ${SSL_*}) sont
# substituées ; les variables nginx ($remote_addr, ...) restent intactes.
# ModSecurity + OWASP CRS sont activés par conf.d/modsecurity.conf (fourni par l'image).
# Inclus dans le bloc http (nginx.conf de l'image), qui définit aussi le `resolver`
# (DNS Docker 127.0.0.11, réécrit au démarrage).

server_tokens off;
more_clear_headers Server;

# --- Liste de blocage IP rechargeable à chaud -----------------------------------------
# L'action de remédiation waf_block_ip / waf_blacklist_ip (playbook Ansible waf_deny_ip.yml)
# ajoute "<ip> 1;" dans security/waf/blocklist/blocked_ips.conf puis `nginx -s reload`.
# Le DOSSIER blocklist/ est monté en lecture seule (pas le fichier : voir le Dockerfile).
# Interface documentée dans le README.
geo $blocked_source {
    default 0;
    include /etc/nginx/blocklist/blocked_ips.conf;
}

server {
    # Ports non privilégiés : le conteneur tourne en non-root avec cap_drop ALL ;
    # le compose publie 80 -> ${PORT} et 443 -> ${SSL_PORT}.
    listen ${PORT} default_server;
    listen ${SSL_PORT} ssl default_server;
    server_name _;

    # Certificat auto-signé généré au premier démarrage par l'image (labo fermé).
    ssl_certificate     ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols       ${SSL_PROTOCOLS};
    ssl_ciphers         ${SSL_CIPHERS};
    ssl_session_timeout 1d;
    ssl_session_cache   shared:WafTLS:10m;
    ssl_session_tickets off;

    # Sonde du healthcheck : locale uniquement. Pas de allow/deny ici : `return` s'exécute
    # (phase rewrite) AVANT le contrôle d'accès et le court-circuiterait. Hors ModSecurity
    # pour ne pas remplir le journal d'audit toutes les 15 s.
    location = /healthz {
        modsecurity off;
        access_log off;
        if ($remote_addr != "127.0.0.1") { return 404; }
        return 200 "OK\n";
    }

    # Blocage des sources mises en liste noire par la remédiation.
    if ($blocked_source) { return 403; }

    # En-têtes de sécurité, posés par le WAF seul (ceux du backend sont masqués : pas de doublon)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    # X-Forwarded-For ÉCRASÉ (pas $proxy_add_x_forwarded_for) : un client ne peut pas
    # usurper une autre IP source auprès des services (logs, rate-limit de l'auth).
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header Host            $host;
    proxy_http_version 1.1;

    # Backends résolus À CHAQUE REQUÊTE (variables + resolver) et non une fois au
    # démarrage : un service redémarré par la remédiation est retrouvé sans reload,
    # et le WAF démarre même si un backend n'est pas encore prêt.
    set $front_app   http://front:8080;
    set $payment_api http://payment-api:8001;
    set $auth_api    http://auth:8002;

    # Front de paiement (statique)
    location / {
        proxy_pass $front_app;
    }

    # API métier — routes explicites : aucun endpoint interne (/metrics, /internal/*,
    # remédiation) n'est atteignable depuis le hotspot.
    location /api/v1/accounts     { proxy_pass $payment_api; }
    location /api/v1/transactions { proxy_pass $payment_api; }

    # API d'authentification (rate-limit applicatif en plus du CRS)
    location /api/v1/login    { proxy_pass $auth_api; }
    location /api/v1/register { proxy_pass $auth_api; }

    # Refus explicites (défense en profondeur) : une route d'API non déclarée ci-dessus et
    # les chemins internes ne tombent jamais dans le `location /` du front.
    location /api/           { return 404; }
    location ^~ /internal/   { return 404; }
    location = /metrics      { return 404; }
}
