# syntax=docker/dockerfile:1
# waf-exporter : journal d'audit ModSecurity -> resilience_waf_blocked_total + event waf_blocked.
# Build depuis security/waf/ :  docker build -f Dockerfile.exporter -t resilience/waf-exporter .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt \
 && groupadd --system --gid 10007 wafexp \
 && useradd --system --uid 10007 --gid wafexp --no-create-home --shell /usr/sbin/nologin wafexp
WORKDIR /app
COPY --chown=root:root waf_exporter.py /app/waf_exporter.py
USER 10007:10007
EXPOSE 9188
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9188/metrics', timeout=2).status == 200 else 1)"]
CMD ["python", "/app/waf_exporter.py", "--audit-log", "/var/log/modsec/audit.json", "--port", "9188"]
