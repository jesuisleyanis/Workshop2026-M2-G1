# Variables substituées au démarrage : REMEDIATION_UPSTREAM, REMEDIATION_AUTH_HEADER, DNS_RESOLVER,
# ASSISTANT_UPSTREAM.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Résolution DNS paresseuse (Docker) : nginx démarre même si "remediation" n'est pas encore up.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;

  include /etc/nginx/security-headers.conf;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Flux SSE du moteur de remédiation. UNIQUEMENT ce chemin (lecture seule) est exposé :
  # l'API /events du moteur reste inaccessible depuis le navigateur. Le jeton éventuel est
  # injecté ici côté serveur ; il n'atteint jamais le bundle JS.
  location = /remediation/stream {
    include /etc/nginx/security-headers.conf;
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation/stream$ /stream break;
    proxy_pass $remediation_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering "no" always;
    add_header Cache-Control "no-cache" always;
  }

  location /remediation/ {
    return 404;
  }

  # Assistant RAG (onglet iframe, lecture seule). UNIQUEMENT GET /assistant/, GET /assistant/static/*
  # et POST /assistant/api/v1/ask ; tout le reste de /assistant/ -> 404. PAS de security-headers.conf
  # ici (X-Frame-Options DENY / frame-ancestors 'none' bloqueraient l'iframe) : les add_header locaux
  # coupent l'héritage du niveau server, et l'assistant envoie sa propre CSP (frame-ancestors 'self').
  location ~ ^/assistant/(static/.+)?$ {
    limit_except GET { deny all; }
    set $assistant_upstream "http://${ASSISTANT_UPSTREAM}";
    rewrite ^/assistant/(.*)$ /$1 break;
    proxy_pass $assistant_upstream;
    proxy_set_header Host $host;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location = /assistant/api/v1/ask {
    limit_except POST { deny all; }
    set $assistant_upstream "http://${ASSISTANT_UPSTREAM}";
    rewrite ^/assistant/(.*)$ /$1 break;
    proxy_pass $assistant_upstream;
    proxy_set_header Host $host;
    # La génération Ollama peut durer jusqu'à 120 s.
    proxy_read_timeout 130s;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location /assistant/ {
    return 404;
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-store";
    try_files $uri /index.html;
  }
}
