# Variables substituées au démarrage : REMEDIATION_UPSTREAM, REMEDIATION_AUTH_HEADER, PROMETHEUS_UPSTREAM, DNS_RESOLVER.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Résolution DNS paresseuse (Docker) : nginx démarre même si "remediation" n'est pas encore up.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;

  include /etc/nginx/security-headers.conf;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Flux SSE du moteur de remédiation. UNIQUEMENT ce chemin (lecture seule) est exposé :
  # l'API /events du moteur reste inaccessible depuis le navigateur. Le jeton éventuel est
  # injecté ici côté serveur ; il n'atteint jamais le bundle JS.
  location = /remediation/stream {
    include /etc/nginx/security-headers.conf;
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation/stream$ /stream break;
    proxy_pass $remediation_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering "no" always;
    add_header Cache-Control "no-cache" always;
  }

  # Carte « IP bloquées » : liste noire du WAF en LECTURE SEULE (GET), jeton injecté côté serveur.
  # Aucune autre route du moteur n'est exposée (pas de déblocage depuis le navigateur).
  location = /remediation/waf/blocked-ips {
    include /etc/nginx/security-headers.conf;
    limit_except GET { deny all; }
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation(/.*)$ $1 break;
    proxy_pass $remediation_upstream;
    proxy_http_version 1.1;
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
  }

  # Bouton « Débloquer » de la carte : SEULE action d'écriture du dashboard. DELETE uniquement + en-tête
  # X-Resilience-Dashboard obligatoire : une page tierce ouverte dans le même navigateur ne peut envoyer
  # ni l'un ni l'autre sans pré-vol CORS, auquel nginx ne répond jamais (anti-CSRF ; le dashboard est sur
  # 127.0.0.1 sans authentification). IP littérale validée dans le chemin.
  location ~ "^/remediation/waf/blocked-ips/([0-9A-Fa-f:.]{2,45})$" {
    include /etc/nginx/security-headers.conf;
    limit_except DELETE { deny all; }
    if ($http_x_resilience_dashboard != "1") { return 403; }
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation(/.*)$ $1 break;
    proxy_pass $remediation_upstream;
    proxy_http_version 1.1;
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
  }

  location /remediation/ {
    return 404;
  }

  # Score ML (resilience_anomaly_score) et santé (up) lus dans Prometheus : UNIQUEMENT
  # l'API de requête instantanée, en GET, en lecture seule. Rien d'autre de Prometheus n'est exposé.
  location = /prometheus/api/v1/query {
    include /etc/nginx/security-headers.conf;
    limit_except GET { deny all; }
    set $prometheus_upstream "http://${PROMETHEUS_UPSTREAM}";
    rewrite ^/prometheus(/.*)$ $1 break;
    proxy_pass $prometheus_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
  }

  location /prometheus/ {
    return 404;
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-store";
    try_files $uri /index.html;
  }
}
