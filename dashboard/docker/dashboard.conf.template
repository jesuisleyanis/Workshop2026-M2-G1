# Variables substituées au démarrage : REMEDIATION_UPSTREAM, REMEDIATION_AUTH_HEADER, PROMETHEUS_UPSTREAM,
# DNS_RESOLVER, ASSISTANT_UPSTREAM.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Résolution DNS paresseuse (Docker) : nginx démarre même si "remediation" n'est pas encore up.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;

  include /etc/nginx/security-headers.conf;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Flux SSE du moteur de remédiation. Seuls deux chemins du moteur sont exposés : ce flux
  # (GET, lecture seule) et POST /remediation/manual-actions (action opérateur confirmée, liste
  # blanche côté moteur). L'API /events reste inaccessible depuis le navigateur. Le jeton est
  # injecté ici côté serveur ; il n'atteint jamais le bundle JS.
  location = /remediation/stream {
    include /etc/nginx/security-headers.conf;
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation/stream$ /stream break;
    proxy_pass $remediation_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
    proxy_hide_header Cache-Control;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
    add_header X-Accel-Buffering "no" always;
    add_header Cache-Control "no-cache" always;
  }

  # Action manuelle confirmée par l'opérateur (panneau « Commande opérateur »). Protégée par
  # l'exposition réseau du dashboard + la confirmation UI + la liste blanche du moteur (422 sinon).
  location = /remediation/manual-actions {
    include /etc/nginx/security-headers.conf;
    limit_except POST { deny all; }
    client_max_body_size 4k;
    # Anti-CSRF : application/json impose un preflight CORS (OPTIONS -> 403 ci-dessus) à toute page
    # tierce ; sans ce contrôle, un POST « simple » sans Content-Type serait lu comme JSON par FastAPI.
    if ($content_type !~* "^application/json") { return 415; }
    set $remediation_upstream "http://${REMEDIATION_UPSTREAM}";
    rewrite ^/remediation/manual-actions$ /manual-actions break;
    proxy_pass $remediation_upstream;
    proxy_set_header Authorization "${REMEDIATION_AUTH_HEADER}";
    proxy_set_header Host $host;
  }

  location /remediation/ {
    return 404;
  }

  # Score ML (resilience_anomaly_score) et santé (up) lus dans Prometheus : UNIQUEMENT
  # l'API de requête instantanée, en GET, en lecture seule. Rien d'autre de Prometheus n'est exposé.
  location = /prometheus/api/v1/query {
    include /etc/nginx/security-headers.conf;
    limit_except GET { deny all; }
    set $prometheus_upstream "http://${PROMETHEUS_UPSTREAM}";
    rewrite ^/prometheus(/.*)$ $1 break;
    proxy_pass $prometheus_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_read_timeout 10s;
    add_header Cache-Control "no-store" always;
  }

  location /prometheus/ {
    return 404;
  }

  # Assistant RAG (onglet iframe + appels du dashboard, sans action sur le système). UNIQUEMENT
  # GET /assistant/, GET /assistant/static/* et POST /assistant/api/v1/(ask|summarize|postmortem|propose) ;
  # tout le reste de /assistant/ -> 404. PAS de security-headers.conf
  # ici (X-Frame-Options DENY / frame-ancestors 'none' bloqueraient l'iframe) : les add_header locaux
  # coupent l'héritage du niveau server, et l'assistant envoie sa propre CSP (frame-ancestors 'self').
  location ~ ^/assistant/(static/.+)?$ {
    limit_except GET { deny all; }
    set $assistant_upstream "http://${ASSISTANT_UPSTREAM}";
    rewrite ^/assistant/(.*)$ /$1 break;
    proxy_pass $assistant_upstream;
    proxy_set_header Host $host;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location ~ ^/assistant/api/v1/(ask|summarize|postmortem|propose)$ {
    limit_except POST { deny all; }
    set $assistant_upstream "http://${ASSISTANT_UPSTREAM}";
    rewrite ^/assistant/(.*)$ /$1 break;
    proxy_pass $assistant_upstream;
    proxy_set_header Host $host;
    # La génération Ollama peut durer jusqu'à 120 s.
    proxy_read_timeout 130s;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
  }

  location /assistant/ {
    return 404;
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "no-store";
    try_files $uri /index.html;
  }
}
