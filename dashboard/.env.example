# Base d'URL du moteur de remédiation (flux SSE = <base>/stream). Évalué au BUILD.
# Défaut "/remediation" : proxifié par Vite en dev et par nginx en prod (le navigateur
# ne parle jamais directement à remediation:8005, qui n'est pas exposé).
VITE_REMEDIATION_BASE=/remediation
# Base de Grafana pour les liens de la barre inférieure. Évalué au BUILD.
VITE_GRAFANA_BASE=http://localhost:3000
# Source des événements : live (défaut) | auto (simulation si flux injoignable) | simulation. Évalué au BUILD.
VITE_STREAM_SOURCE=live
# Dev uniquement : cible du proxy Vite pour /remediation (moteur réel ou `npm run mock`).
REMEDIATION_PROXY_TARGET=http://localhost:8005
