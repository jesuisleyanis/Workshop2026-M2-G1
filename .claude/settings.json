{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PROJECT_CODE": "Workshop2026-M2-G1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx vitest:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(make test:*)",
      "Bash(make verify:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./security/sops/*.key)",
      "Read(./**/*.age)",
      "Read(./**/age.key)"
    ]
  }
}
